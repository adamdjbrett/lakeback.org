<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set seo_title = title or metadata.title %}
{% set seo_description = description or metadata.description %}
{% set canonicalHref = canonical_url or (metadata.url ~ page.url) %}
{% set is_post = page.url and page.url.startsWith('/blog/') and not pagination %}
{% set seo_image = image | ogImage(metadata.og_image) %}
{% if seo_image and "http" not in seo_image %}{% set seo_image = metadata.url ~ seo_image %}{% endif %}
<title>{{ seo_title }}</title>
<meta name="description" content="{{ seo_description }}">
{# Open Graph uses property=, Twitter/X uses name= #}
<meta property="og:type" content="{{ 'article' if is_post else 'website' }}">
<meta property="og:title" content="{{ seo_title }}">
<meta property="og:description" content="{{ seo_description }}">
<meta property="og:url" content="{{ canonicalHref }}">
<meta property="og:site_name" content="{{ metadata.title }}">
<meta property="og:locale" content="{{ metadata.locale }}">
<meta property="og:image" content="{{ seo_image }}">
<meta property="og:image:alt" content="{{ seo_title }}">
{% if is_post %}<meta property="article:published_time" content="{{ page.date | htmlDateString }}">
<meta property="article:publisher" content="{{ metadata.metasocial[1].facebook }}">
{% if tags %}{% for tag in tags | filterTagList %}<meta property="article:tag" content="{{ tag }}">
{% endfor %}{% endif %}{% endif %}<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="{{ metadata.metasocial[2].twitteruser }}">
<meta name="twitter:creator" content="{{ metadata.metasocial[2].twitteruser }}">
<meta name="twitter:title" content="{{ seo_title }}">
<meta name="twitter:description" content="{{ seo_description }}">
<meta name="twitter:image" content="{{ seo_image }}">
<meta name="twitter:image:alt" content="{{ seo_title }}">
<!-- Favicon and Apple Touch Icon -->
<link rel="icon" type="image/png" href="/img/favicon/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/img/favicon/favicon.svg" />
<link rel="shortcut icon" href="/img/favicon/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/img/favicon/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="#LAKEBACK" />
<link rel="manifest" href="/img/favicon/site.webmanifest" />
{% if canonical_url %}<link rel="canonical" href="{{ canonical_url}}"/>{% else %}<link rel="canonical" href="{{ metadata.url }}{{ page.url }}"/>{% endif %}
{% set seo_creators = [] %}
{% if is_post and authors %}{% for authorKey in authors %}{% set a = authors | getAuthor(authorKey) %}{% if a and seo_creators.push(a.name) %}{% endif %}{% endfor %}{% endif %}
{% if not seo_creators.length %}{% set seo_creators = [metadata.organization.name] %}{% endif %}
{# Dublin Core (DC-HTML), every page #}
<link rel="schema.DC" href="http://purl.org/dc/elements/1.1/">
<link rel="schema.DCTERMS" href="http://purl.org/dc/terms/">
<meta name="DC.title" content="{{ seo_title }}">
{% for n in seo_creators %}<meta name="DC.creator" content="{{ n }}">
{% endfor %}<meta name="DC.description" content="{{ seo_description }}">
<meta name="DC.publisher" content="{{ metadata.organization.name }}">
<meta name="DC.relation" content="{{ metadata.organization.url }}">
<meta name="DC.identifier" content="{{ canonicalHref }}">
<meta name="DC.language" content="{{ metadata.language }}">
<meta name="DC.format" content="text/html">
<meta name="DC.type" content="Text">
{% if date %}<meta name="DCTERMS.issued" content="{{ date | htmlDateString }}">
{% endif %}{% if tags %}{% for tag in tags | filterTagList %}<meta name="DC.subject" content="{{ tag }}">
{% endfor %}{% endif %}
{# Zotero: title rides on og:title/DC.title only; citation_title would make Zotero guess journalArticle #}
<meta property="zotero:itemType" content="{{ 'blogPost' if is_post else 'webpage' }}">
<meta name="prism.publicationName" content="{{ metadata.title }}">
{% for n in seo_creators %}<meta name="citation_author" content="{{ n }}">
{% endfor %}{% if date %}<meta name="citation_publication_date" content="{{ date | htmlDateString }}">
{% endif %}<meta name="citation_public_url" content="{{ canonicalHref }}">
<meta name="citation_language" content="{{ metadata.language or 'en' }}">
{% if is_post %}
<link rel="cite-as" href="{{ canonicalHref }}">
<link rel="type" href="https://schema.org/BlogPosting">
<link rel="author" href="{{ metadata.author.url }}">
<link rel="human-json" href="/humans.json">
<link rel="describedby" type="application/ld+json" profile="https://schema.org/" href="{{ page.url }}metadata.json">
{% else %}
<link rel="describedby" type="application/ld+json" profile="https://schema.org/" href="/metadata.json">
{% endif %}
{# lakeback.org is a project and program of AILA: AILA's profiles are this site's identities #}
<link rel="me" href="{{ metadata.organization.url }}">
{% for u in metadata.organization.same_as %}<link rel="me" href="{{ u }}">
{% endfor %}<link rel="me" href="mailto:{{ metadata.organization.email }}">
<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
<link rel="alternate" href="{{ metadata.podcast.feed }}" type="application/rss+xml" title="{{ metadata.podcast.title }} (podcast)">
<meta name="generator" content="{{ eleventy.generator }}">
<script async src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script type="application/ld+json">{% include "partials/site-graph-jsonld.njk" %}</script>
{%- css %}{% include "public/css/bs.css" %}{% endcss %}<style>{% getBundle "css" %}</style>
{%- js %}{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}{% endjs %}
