{%- set orgId = metadata.organization.url ~ "#organization" -%}
{%- set projectId = metadata.url ~ "/#project" -%}
{
  "@context": "https://schema.org",
  "@graph": [
  {% include "partials/organization-jsonld.njk" %},
  {
    "@type": "Project",
    "@id": {{ projectId | dump | safe }},
    "name": {{ metadata.title | dump | safe }},
    "alternateName": "#Lakeback",
    "description": {{ metadata.description | dump | safe }},
    "url": {{ (metadata.url ~ "/") | dump | safe }},
    "parentOrganization": { "@id": {{ orgId | dump | safe }} }
  },
  {
    "@type": "WebSite",
    "@id": {{ (metadata.url ~ "/#website") | dump | safe }},
    "name": {{ metadata.title | dump | safe }},
    "description": {{ metadata.description | dump | safe }},
    "url": {{ (metadata.url ~ "/") | dump | safe }},
    "inLanguage": {{ metadata.language | dump | safe }},
    "about": { "@id": {{ projectId | dump | safe }} },
    "publisher": { "@id": {{ orgId | dump | safe }} }
  },
  {#- PodcastSeries node: verbatim copy of podcast.lakeback.org's built node; never hand-edit _data/podcastSeries.json.
      Regenerate from the podcast.lakeback.org repo after `npm run build` (production URLs, never a dev build):
      node -e 'const fs=require("fs");const h=fs.readFileSync("dist/index.html","utf8");const g=JSON.parse(h.match(/<script type="application\/ld\+json">([\s\S]*?)<\/script>/)[1])["@graph"];fs.writeFileSync("../lakeback.org/_data/podcastSeries.json",JSON.stringify(g.find(n=>n["@type"]==="PodcastSeries"),null,2)+"\n")' #}
  {{ podcastSeries | dump | safe }}
  ]
}
