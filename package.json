{
  "name": "11ty-lakeback",
  "version": "1.0.0",
  "description": "11ty lakeback by Adam Dj Brett",
  "type": "module",
  "scripts": {
    "build": "buildawesome",
    "build-nocolor": "NODE_DISABLE_COLORS=1 buildawesome",
    "dev": "buildawesome --serve --port=8080 & until curl -s -o /dev/null http://localhost:8080; do sleep 0.5; done; open http://localhost:8080; wait",
    "start": "buildawesome --serve --quiet --port=8080",
    "debug": "DEBUG='Eleventy*' node node_modules/@awesome.me/buildawesome/cmd.js",
    "debugstart": "DEBUG='Eleventy*' node node_modules/@awesome.me/buildawesome/cmd.js --serve --quiet --port=8080",
    "benchmark": "DEBUG='Eleventy:Benchmark*' node node_modules/@awesome.me/buildawesome/cmd.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/adamdjbrett/lakeback.org.git"
  },
  "author": {
    "name": "Adam Dj Brett",
    "email": "info@adamdjbrett.com",
    "url": "https://adamdjbrett.com/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "npm": ">=11.14.0"
  },
  "devDependencies": {
    "@11ty/eleventy-navigation": "1.0.5",
    "@11ty/eleventy-plugin-rss": "2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
    "js-yaml": "5.5.0",
    "luxon": "3.7.2",
    "markdown-it": "^14.2.0",
    "zod": "4.6.7",
    "zod-validation-error": "5.0.0"
  },
  "dependencies": {
    "@awesome.me/buildawesome": "4.0.0-alpha.12",
    "@zachleat/heading-anchors": "1.0.5",
    "clean-css": "5.3.3",
    "eleventy-plugin-toc": "1.1.5",
    "markdown-it-anchor": "9.2.0",
    "pagefind": "1.4.0",
    "string-strip-html": "13.5.3"
  },
  "packageManager": "npm@11.14.0"
}
